# Runtime configuration, validated at start-up (src/clients/env.ts). Copy to .env.local to override.
# No secrets: every value here is safe to commit.

# Path to the SQLite file. The app opens it read-only; db:migrate and db:seed write it at build time.
DATABASE_URL=./data/rayblue.db

# Release version reported by GET /api/health. Defaults to package.json "version".
APP_VERSION=

# Minimum server log level: debug | info | warn | error. Default info.
LOG_LEVEL=info

# Requests allowed per client IP per minute, counted per process (ADR 0004). 0 turns a limit off.
# Pages include client navigations and link prefetches. Defaults 120 and 30.
RATE_LIMIT_PAGES_PER_MINUTE=
RATE_LIMIT_API_PER_MINUTE=

# Seed only (npm run db:seed): PRNG seed (integer 0..4294967295) and the dataset as-of time,
# an ISO 8601 date-time with offset. Defaults: 20261024 and 2026-10-24T09:00:00+11:00.
SEED=
SEED_AS_OF=
